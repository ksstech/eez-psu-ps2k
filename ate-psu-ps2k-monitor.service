# /etc/systemd/system/ate-psu-ps2k-monitor.service
#
# EA-PS2000B health check — oneshot service triggered by ate-psu-ps2k-monitor.timer
#
# Runs psu-ps2k-monitor.py once (exits 0=OK, 1=fail).
# Results logged to syslog under tag 'ate-psu-ps2k-monitor'.
#
# View results:
#   journalctl -t ate-psu-ps2k-monitor -f
#   journalctl -t ate-psu-ps2k-monitor -n 50 --no-pager
#
# Installation:
#   sudo cp ate-psu-ps2k-monitor.service ate-psu-ps2k-monitor.timer /etc/systemd/system/
#   sudo cp psu-ps2k-monitor.py /opt/ate-psu-ps2k/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ate-psu-ps2k-monitor.timer
#   sudo systemctl list-timers ate-psu-ps2k-monitor.timer

[Unit]
Description=EA-PS2000B Bridge Health Check
After=network.target ate-psu-ps2k-bridge.service

[Service]
Type=oneshot
# User confirmed via audit: whoami = vh on this RPi5
User=vh
ExecStart=/usr/bin/python3 /opt/ate-psu-ps2k/psu-ps2k-monitor.py --quiet
# Exit code 1 = health check failed — logged to syslog, not treated as crash
SuccessExitStatus=0 1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
